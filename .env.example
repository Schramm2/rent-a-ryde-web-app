# Frontend API target used by Vue dev-server proxy and direct service calls.
# Leave blank to use same-origin /api paths in deployed environments.
VUE_APP_API_BASE_URL=http://localhost:3000

# Firebase client configuration. These are public Firebase app identifiers,
# but real project values should still be kept in local .env files.
VUE_APP_FIREBASE_API_KEY=replace-with-firebase-api-key
VUE_APP_FIREBASE_AUTH_DOMAIN=replace-with-project.firebaseapp.com
VUE_APP_FIREBASE_PROJECT_ID=replace-with-project-id
VUE_APP_FIREBASE_STORAGE_BUCKET=replace-with-project.appspot.com
VUE_APP_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
VUE_APP_FIREBASE_APP_ID=replace-with-app-id
VUE_APP_FIREBASE_MEASUREMENT_ID=replace-with-measurement-id
